# ETL Webhook Configuration
ETL_WEBHOOK_URL=http://localhost:3001/webhook/events
ETL_WEBHOOK_SECRET=your-webhook-secret-here

# Postgres Configuration (Neon)
# Option 1: Use DATABASE_URL (recommended for Render/Neon)
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Option 2: Use individual connection parameters
PGHOST=your-host.neon.tech
PGPORT=5432
PGDATABASE=your-database
PGUSER=your-user
PGPASSWORD=your-password
PGSCHEMA=public
PGSSLMODE=require

# Convex Configuration (for export actions)
CONVEX_DEPLOY_KEY=your-convex-deploy-key

# dbt Configuration
DBT_PROFILES_DIR=./etl
